@model Ecommerce.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    // Layout = "_Layout"; // Uncomment if the project uses a common layout
}

<div class="bg-gray-50 min-h-screen">
    @* Assume you have partial _Header, otherwise delete *@
    @* <partial name="_Header" /> *@

    <div class="max-w-6xl mx-auto px-4 py-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-10">
            Reset Password
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Form -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-10">
                <h2 class="text-2xl font-semibold mb-4">
                    Create New Password
                </h2>
                <p class="text-gray-600 mb-8">
                    Please enter your new password below.
                </p>

                <form asp-controller="Auth" asp-action="ResetPassword" method="post">
                    <!-- Keep hidden email to send to the Server -->
                    <input type="hidden" asp-for="Email" />

                    <!-- New Password -->
                    <div class="mb-6">
                        <label asp-for="NewPassword" class="block text-sm font-semibold mb-2">
                            New Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="bi bi-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input asp-for="NewPassword" type="password" placeholder="Enter new password" required
                                   class="w-full h-12 pl-12 pr-4 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-6">
                        <label asp-for="ConfirmPassword" class="block text-sm font-semibold mb-2">
                            Confirm Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="bi bi-shield-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input asp-for="ConfirmPassword" type="password" placeholder="Confirm new password" required
                                   class="w-full h-12 pl-12 pr-4 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="mb-6">
                            <p class="text-red-500 text-sm">
                                <i class="bi bi-exclamation-circle"></i>
                                @ViewBag.Error
                            </p>
                        </div>
                    }

                    <div class="flex items-center gap-4">
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-10 h-12 rounded-full transition">
                            Reset Password
                        </button>
                        <a asp-controller="Auth" asp-action="Login" class="text-blue-600 hover:underline">
                            Back To Login
                        </a>
                    </div>
                </form>
            </div>

            <!-- Right Side -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-10">
                <h2 class="text-2xl font-semibold mb-4">Password Requirements</h2>
                <p class="text-gray-600 mb-6">For better security, your password should follow these recommendations.</p>
                <div class="space-y-5">
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                            <i class="bi bi-check-lg text-blue-600"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold">Minimum 8 Characters</h3>
                            <p class="text-sm text-gray-500">Use at least 8 characters.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                            <i class="bi bi-shield-check text-blue-600"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold">Strong Password</h3>
                            <p class="text-sm text-gray-500">Combine letters, numbers and special characters.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                            <i class="bi bi-lock-fill text-blue-600"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold">Keep It Private</h3>
                            <p class="text-sm text-gray-500">Never share your password with anyone.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
