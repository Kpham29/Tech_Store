@using Ecommerce.Web.Models
@model Ecommerce.Web.Models.ProductViewModelList
@{
    ViewData["Title"] = "TechStore";
}

<section class="mt-5 mb-3 flex justify-center items-center mr-4 ml-4">
    <img src="~/images/banner/topbanner.png" alt="banner" class="w-full h-full object-cover rounded-md" />
</section>      

<section class="mx-5 my-6">
    <div class="flex justify-between items-center mb-5">
        <h2 class="text-2xl font-semibold">
            Categories
        </h2>
    </div>
    <div class="grid grid-cols-5 gap-6">
        <div class="border border-gray-400 rounded-md p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="images/features/banner_laptop.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded text-teal-900 font-bold">Laptops</span>
        </div>
        <div class="border border-gray-400 rounded-md p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="images/features/banner_manhinh.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded text-teal-900 font-bold">Monitors</span>
        </div>
        <div class="border border-gray-400 rounded-md p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="images/features/banner_chuot.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded text-teal-900 font-bold">Mices</span>
        </div>
        <div class="border border-gray-400 rounded-md p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="images/features/banner_banphim.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded text-teal-900 font-bold">Keyboards</span>
        </div>
        <div class="border border-gray-400 rounded-md p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="images/features/banner_tainghe.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded text-teal-900 font-bold">Headsets</span>
        </div>
    </div>
</section>

<section class="mx-5 my-6">
    <div class="flex justify-between items-center mb-5">
        <h2 class="text-2xl font-semibold">New Products</h2>
        <a href="/Catalog?isNew=true" class="text-blue-600 hover:underline">
            See All New Products
        </a>
    </div>
    <div class="grid grid-cols-6 gap-6">
        @if (Model != null && Model.NewProducts.Any())
        {
            @foreach (var item in Model.NewProducts)
            {
                <a class="border rounded-lg p-4 h-[320px] flex flex-col hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
                   href="/Catalog/ProductDetail/@item.ProductId">
                    <div class="h-[150px] flex items-center justify-center">
                        <img src="http://localhost:5678@(item.Thumbnail)" alt="@item.ProductName" class="max-h-full object-contain" />
                    </div>
                    
                    <h3 class="text-sm font-medium leading-5 line-clamp-2 mt-2">
                        @item.ProductName
                    </h3>
                    
                    <div class="flex items-center mt-2">
                        <i class="bi bi-star-fill text-[#ff8a00]"></i>
                        <span class="text-xs text-gray-500 ml-2">(5.0)</span>
                    </div>
                    
                    <div class="mt-auto pt-4 flex items-center justify-between">
                        <p class="font-bold text-md text-red-600">
                            @item.Price.ToString("#,##0") VND
                        </p>
                        <button type="button" class="w-10 h-10 border border-gray-300 rounded-md flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all duration-300">
                            <i class="bi bi-cart-plus"></i>
                        </button>
                    </div>
                </a>
            }
        }
        else
        {
            <p class="text-gray-500">There is no new products</p>
        }
    </div>
</section>

<section class="mx-4 my-8">
    <div class="bg-[#eef2ff] h-[70px] rounded flex items-center justify-center">
        <span class="font-semibold text-gray-700">
            Financing Promotion Banner
        </span>
    </div>
</section>

<section class="mx-5 my-6">
    <div class="grid grid-cols-[280px_1fr] gap-6">
        <div class="relative h-[420px] overflow-hidden rounded">
            <img src="~/images/banner/leftbanner1.png" alt="leftbanner" class="w-full h-full object-cover">
            <div class="absolute inset-0 flex items-center justify-center">
                <h2 class="text-white text-4xl font-bold text-center leading-tight">Laptops</h2>
            </div>
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
                <a href="/Catalog?cateId=1" class="text-white text-lg underline hover:text-gray-300 transition">See All Products</a>
            </div>
        </div>
        <div>
            <div class="grid grid-cols-5 gap-6">
                @if (Model != null && Model.Laptops.Any())
                {
                    @foreach (var item in Model.Laptops)
