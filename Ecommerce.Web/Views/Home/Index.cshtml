            <img src="~/images/features/f2.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded bg-pink-100 text-teal-900 font-semibold">Online order</span>
        </div>
        <div class="border border-gray-200 rounded-lg p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="~/images/features/f3.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded bg-pink-100 text-teal-900 font-semibold">Save money</span>
        </div>
        <div class="border border-gray-200 rounded-lg p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="~/images/features/f4.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded bg-pink-100 text-teal-900 font-semibold">Promotions</span>
        </div>
        <div class="border border-gray-200 rounded-lg p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="~/images/features/f5.png" alt="feature" class="h-32 object-contain" />
            <span class="mt-4 px-4 py-2 rounded bg-pink-100 text-teal-900 font-semibold">Happy sell</span>
        </div>
        <div class="border border-gray-200 rounded-lg p-6 flex flex-col items-center hover:shadow-md transition">
            <img src="~/images/features/f6.png" alt="feature" class="h-32 object-contain" />
