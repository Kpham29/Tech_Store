<section class="mt-5 mb-3 flex justify-center items-center mr-4 ml-4">
    <img src="~/images/banner/bottombanner1.png" alt="banner" class="w-full h-[420px] object-cover rounded-md" />
</section> 

<section class="bg-[#f5f5f7] py-16">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div class="flex flex-col items-center text-center">
                <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center">
                    <img src="~/images/icons/Support.png" class="text-white text-lg" />
                </div>
                <h3 class="mt-6 text-lg font-semibold text-black">Product Support</h3>
                <p class="mt-2 text-sm text-gray-500 max-w-[260px]">Up to 3 years on-site warranty available for your peace of mind.</p>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center">
                    <img src="~/images/icons/Account.png" class="text-white text-lg" />
                </div>
                <h3 class="mt-6 text-lg font-semibold text-black">Personal Account</h3>
                <p class="mt-2 text-sm text-gray-500 max-w-[260px]">With big discounts, free delivery and a dedicated support specialist.</p>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center">
                    <img src="~/images/icons/Saving.png" class="text-white text-lg" />
                </div>
                <h3 class="mt-6 text-lg font-semibold text-black">Amazing Savings</h3>
                <p class="mt-2 text-sm text-gray-500 max-w-[260px]">Up to 70% off new products, you can be sure of the best price.</p>
            </div>
        </div>
    </div>
</section>