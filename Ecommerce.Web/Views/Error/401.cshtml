@{
    Layout = null;
}
<!DOCTYPE html>
<html>
    <head>
        <title>401 - Unauthorized</title>
        <link rel="stylesheet" href="/css/style.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <script src="https://cdn.tailwindcss.com"></script>
    </head>
    <body class="bg-slate-50">
        <section class="min-h-screen flex items-center justify-center relative overflow-hidden">
            <!-- Background decoration -->
            <div class="absolute -top-32 -left-32 w-72 h-72 rounded-full bg-blue-100 opacity-50"></div>
            <div class="absolute -bottom-40 -right-32 w-96 h-96 rounded-full bg-blue-200 opacity-40"></div>
            <div class="absolute top-1/3 right-20 w-20 h-20 rounded-full bg-blue-300 opacity-20"></div>

            <!-- Card -->
            <div class="relative bg-white rounded-3xl shadow-xl border border-gray-200 w-full max-w-xl px-12 py-14 text-center">
                <!-- Logo -->
                <h2 class="text-3xl font-bold text-blue-600 tracking-wide">
                    TechStore
                </h2>
                <div class="w-28 h-28 rounded-full bg-yellow-100 flex items-center justify-center mx-auto mt-6">
                    <i class="bi bi-shield-lock-fill text-6xl text-yellow-500"></i>
                </div>
                <h1 class="text-8xl font-extrabold text-blue-600 mt-8">
                    401
                </h1>
                <h2 class="text-3xl font-semibold mt-4">
                    Unauthorized
                </h2>
                <p class="mt-4 text-gray-500 leading-7">
                    You don't have permission to access this page.
                    Please sign in with an authorized account.
                </p>
                <div class="flex justify-center gap-4 mt-10">
                    <a href="/Auth/Login" class="px-7 py-3 rounded-xl bg-blue-600 text-white hover:bg-blue-700 transition">
                        Login
                    </a>
                    <a href="/" class="px-7 py-3 rounded-xl border hover:bg-gray-100 transition">
                        Home
                    </a>
                </div>
            </div>
        </section>
    </body>
</html>
