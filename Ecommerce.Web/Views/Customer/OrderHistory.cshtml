@model Ecommerce.BusinessObject.Helpers.PagedResult<Ecommerce.Web.Models.OrderHistoryViewModel>
@{
    ViewData["Title"] = "Order History";
    var avatarStr = ViewBag.Avatar as string;
    var username = ViewBag.Username as string;
    var avatarUrl = string.IsNullOrEmpty(avatarStr) ? "/images/default-avatar.png" : "http://localhost:5678" + avatarStr;
}

<div class="container mx-auto px-4 pt-6 pb-2 max-w-6xl">
    <div class="text-sm text-gray-500 font-medium">
        <a href="/" class="hover:text-blue-600 transition">Home</a>
        <span class="mx-2">|</span>
        <span class="text-gray-800">Order History</span>
    </div>
</div>

<div class="container mx-auto px-4 pb-8 max-w-6xl flex gap-8">
    <!-- Sidebar -->
    <aside class="w-1/4">
        <div class="flex items-center gap-3 mb-6">
            <img src="@avatarUrl" class="w-12 h-12 rounded-full object-cover border border-gray-200" alt="Avatar">
            <div>
                <h3 class="font-semibold text-gray-800">@username</h3>
                <a href="/Customer/Profile" class="text-sm text-gray-500 hover:text-blue-600"><i class="bi bi-pencil"></i> Edit Profile</a>
            </div>
        </div>
        <nav class="flex flex-col gap-2 text-[15px]">
            <a href="/Customer/Profile" class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:text-blue-600 transition hover:bg-blue-50 rounded-lg">
                <i class="bi bi-person text-xl"></i> Profile
            </a>
            <a href="/Customer/ChangePassword" class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:text-blue-600 transition hover:bg-blue-50 rounded-lg">
                <i class="bi bi-lock text-xl"></i> Change Password
            </a>
            <a href="/Customer/OrderHistory" class="flex items-center gap-3 px-4 py-2 text-blue-600 font-medium transition hover:bg-blue-50 rounded-lg">
                <i class="bi bi-receipt text-xl"></i> Orders
            </a>
            <a href="/Auth/Logout" class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:text-blue-600 transition hover:bg-blue-50 rounded-lg mt-2">
                <i class="bi bi-box-arrow-right text-xl"></i> Logout
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="w-3/4 bg-white rounded shadow-sm border border-gray-100 p-8">
        <div class="border-b border-gray-200 pb-4 mb-6">
            <h1 class="text-xl font-medium text-gray-800">Order History</h1>
            <p class="text-sm text-gray-500 mt-1">View and manage your recent orders</p>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600">
                    <thead class="bg-gray-50 text-gray-700 font-semibold uppercase text-xs">
                        <tr>
                            <th class="px-4 py-3 rounded-l-lg">Order ID</th>
                            <th class="px-4 py-3">Order Date</th>
                            <th class="px-4 py-3">Total Amount</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3 rounded-r-lg text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var order in Model.Items)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-4 py-4 font-medium text-gray-800">#@order.OrderId</td>
                                <td class="px-4 py-4">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-4 py-4 font-semibold text-gray-700">@order.TotalAmount.ToString("N0") VNĐ</td>
                                <td class="px-4 py-4">
                                    @{
                                        var badgeClass = order.Status.ToLower() switch
                                        {
                                            "pending" => "bg-yellow-100 text-yellow-800 border-yellow-200",
                                            "processing" => "bg-blue-100 text-blue-800 border-blue-200",
                                            "delivering" => "bg-indigo-100 text-indigo-800 border-indigo-200",
                                            "delivered" => "bg-green-100 text-green-800 border-green-200",
                                            "cancelled" => "bg-red-100 text-red-800 border-red-200",
                                            "returned" => "bg-gray-100 text-gray-800 border-gray-200",
                                            "exchanged" => "bg-purple-100 text-purple-800 border-purple-200",
                                            _ => "bg-gray-100 text-gray-800 border-gray-200"
                                        };
                                    }
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @badgeClass">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-center">
                                    <a href="/Customer/OrderDetail/@order.OrderId" class="inline-flex items-center px-3 py-1.5 border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white rounded-md text-xs font-medium transition">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination UI -->
            @if (Model.TotalPages > 1)
            {
                <div class="mt-8 flex justify-center">
                    <nav class="inline-flex rounded-md shadow-sm" aria-label="Pagination">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative inline-flex items-center px-4 py-2 border border-blue-600 bg-blue-600 text-sm font-medium text-white">
                                    @i
                                </span>
                            }
                            else
                            {
                                <a href="/Customer/OrderHistory?pageIndex=@i&pageSize=@Model.PageSize" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                    @i
                                </a>
                            }
                        }
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-md mt-6">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="bi bi-info-circle text-blue-400"></i>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-blue-700">
                            You don't have any orders yet.
                        </p>
                    </div>
                </div>
            </div>
        }
    </main>
</div>
