@{
    ViewData["Title"] = "Payment Successful";
}

<div class="max-w-screen-md mx-auto px-6 py-12">
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 text-center">
        <div class="w-20 h-20 bg-green-100 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="bi bi-check-lg text-4xl font-bold"></i>
        </div>
        <h2 class="text-3xl font-bold text-gray-800 mb-4">Payment Successful!</h2>
        <p class="text-gray-600 mb-6">Thank you for your purchase. Your payment has been successfully processed.</p>
        
        @if (!string.IsNullOrEmpty(ViewBag.TransactionId))
        {
            <div class="bg-gray-50 rounded-lg p-4 mb-6 inline-block">
                <span class="text-sm text-gray-500">Transaction ID:</span>
                <span class="font-bold text-gray-800 ml-2">@ViewBag.TransactionId</span>
            </div>
        }

        <div>
            <a href="/" class="inline-block bg-blue-600 text-white font-medium py-3 px-8 rounded-lg hover:bg-blue-700 transition">
                Continue Shopping
            </a>
            <a href="/Customer/Profile" class="inline-block bg-gray-100 text-gray-700 font-medium py-3 px-8 rounded-lg hover:bg-gray-200 transition ml-4">
                View My Orders
            </a>
        </div>
    </div>
</div>
