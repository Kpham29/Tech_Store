@model Ecommerce.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    var avatarUrl = string.IsNullOrEmpty((string)ViewBag.Avatar) ? "/images/default-avatar.png" : "http://localhost:5678" + ViewBag.Avatar;
}

<div class="container mx-auto px-4 pt-6 pb-2 max-w-6xl">
    <div class="text-sm text-gray-500 font-medium">
        <a href="/" class="hover:text-blue-600 transition">Home</a>
        <span class="mx-2">|</span>
        <span class="text-gray-800">Change Password</span>
    </div>
</div>
<div class="container mx-auto px-4 pb-8 max-w-6xl flex gap-8">
    <!-- Sidebar -->
    <aside class="w-1/4">
        <div class="flex items-center gap-3 mb-6">
            <img src="@avatarUrl" class="w-12 h-12 rounded-full object-cover border border-gray-200" alt="Avatar">
            <div>
                <h3 class="font-semibold text-gray-800">@ViewBag.Username</h3>
                <a href="/Customer/Profile" class="text-sm text-gray-500 hover:text-blue-600"><i class="bi bi-pencil"></i> Edit Profile</a>
            </div>
        </div>
        <nav class="flex flex-col gap-2 text-[15px]">
            <a href="/Customer/Profile" class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:text-blue-600 transition hover:bg-blue-50 rounded-lg">
                <i class="bi bi-person text-xl"></i> Profile
            </a>
            <a href="/Customer/ChangePassword" class="flex items-center gap-3 px-4 py-2 text-blue-600 font-medium transition hover:bg-blue-50 rounded-lg">
                <i class="bi bi-lock text-xl"></i> Change Password
            </a>
            <a href="/Customer/Orders" class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:text-blue-600 transition hover:bg-blue-50 rounded-lg">
                <i class="bi bi-receipt text-xl"></i> Orders
            </a>
            <a href="/Auth/Logout" class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:text-blue-600 transition hover:bg-blue-50 rounded-lg mt-2">
                <i class="bi bi-box-arrow-right text-xl"></i> Logout
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="w-3/4 bg-white rounded shadow-sm border border-gray-100 p-8">
        <div class="border-b border-gray-200 pb-4 mb-6">
            <h1 class="text-xl font-medium text-gray-800">Change Password</h1>
            <p class="text-sm text-gray-500 mt-1">Please enter your current password and a new secure password.</p>
        </div>

        @if (ViewBag.Success != null)
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md text-sm">
                @ViewBag.Success
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md text-sm">
                @ViewBag.Error
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="w-full max-w-lg">
            
            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Old Password</label>
                <div class="w-2/3">
                    <input type="password" asp-for="OldPassword" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" required />
                </div>
            </div>

            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">New Password</label>
                <div class="w-2/3">
                    <input type="password" asp-for="NewPassword" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" required />
                </div>
            </div>

            <div class="mb-6 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Confirm Password</label>
                <div class="w-2/3">
                    <input type="password" asp-for="ConfirmNewPassword" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm" required />
                </div>
            </div>

            <div class="flex items-center">
                <div class="w-1/3 pr-6"></div>
                <div class="w-2/3">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-md transition text-sm">
                        Update Password
                    </button>
                </div>
            </div>
        </form>
    </main>
</div>
