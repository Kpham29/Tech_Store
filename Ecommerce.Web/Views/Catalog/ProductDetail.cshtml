@model Ecommerce.Web.Models.ProductDetailViewModel
@{
    ViewData["Title"] = Model.ProductName;
}

<div class="bg-[#ececec] min-h-screen py-6">
    <div class="w-full px-4 md:px-8 lg:px-12 mx-auto">
        
        <div class="bg-white rounded-xl shadow-sm p-6 lg:p-8 mb-8">
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
                
                <div class="lg:w-5/12 flex flex-col justify-start">
                    <div class="border border-gray-200 rounded-xl mb-4 w-full h-[450px] flex items-center justify-center p-4 relative bg-white">
                        <img id="mainImage" src="http://localhost:5678@(Model.Thumbnail)" alt="@Model.ProductName" class="object-contain max-h-full max-w-full" />
                    </div>
                    
                    @if (Model.ProductImages != null && Model.ProductImages.Count > 1)
                    {
                        <div class="flex gap-4 w-full overflow-x-auto py-2 px-1">
                            @foreach (var img in Model.ProductImages)
                            {
                                <div class="w-20 h-20 flex-shrink-0 border border-gray-200 rounded-lg p-2 cursor-pointer hover:border-blue-500 transition bg-white"
                                     onclick="document.getElementById('mainImage').src='http://localhost:5678@(img)'">
                                    <img src="http://localhost:5678@(img)" class="object-contain w-full h-full" />
                                </div>
                            }
                        </div>
                    }
                </div>
                
                <div class="lg:w-7/12 flex flex-col justify-start">
                    <h1 class="text-3xl font-bold text-gray-900 mb-6 leading-tight">
                        @Model.ProductName
                    </h1>
                    
                    <div class="flex items-center gap-2 mb-3">
                        <div class="text-yellow-400 flex text-lg">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star"></i>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-y-4 text-sm mb-8 text-gray-700">
                        <div><span class="font-semibold w-24 inline-block">Sku:</span> @Model.ProductId</div>
                        <div><span class="font-semibold w-24 inline-block">Availability:</span> 
                            <span class="font-bold @(Model.Quantity > 0 ? "text-green-600" : "text-red-600")">
                                @(Model.Quantity > 0 ? "In Stock" : "Out of Stock")
                            </span>
                        </div>
                        <div><span class="font-semibold w-24 inline-block">Brand:</span> @Model.BrandName</div>
                        <div><span class="font-semibold w-24 inline-block">Category:</span> @Model.CategoryName</div>
                    </div>
                    
                    <div class="mb-8">
                        <span class="text-4xl font-bold text-red-600">@Model.Price.ToString("N0") VND</span>
                    </div>
                    
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex border border-gray-300 rounded-xl h-[50px] items-center bg-white overflow-hidden flex-shrink-0">
                            <button id="btn-detail-minus" class="px-4 py-2 text-gray-600 hover:bg-gray-100 hover:text-blue-600 transition h-full"><i class="bi bi-dash"></i></button>
                            <input type="text" id="detail-qty-input" value="1" class="w-12 text-center font-semibold focus:outline-none border-x border-gray-200 h-full" readonly />
                            <button id="btn-detail-plus" class="px-4 py-2 text-gray-600 hover:bg-gray-100 hover:text-blue-600 transition h-full"><i class="bi bi-plus"></i></button>
                        </div>

                        <button id="btn-detail-add-cart" class="h-[50px] px-8 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition">
                            Add to Cart
                        </button>
                        
                        <button class="flex-1 bg-gray-800 text-white font-semibold py-3 px-4 rounded-xl hover:bg-gray-900 transition flex items-center justify-center gap-2 h-[50px] shadow-md hover:shadow-lg">
                            <span>Buy Now</span>
                        </button>
                    </div>
                    
                    <div class="flex items-center justify-between text-sm text-gray-600 pt-4 border-t border-gray-200">
                        <button class="hover:text-red-500 flex items-center gap-2 font-medium transition">
                            <i class="bi bi-heart text-lg"></i> Add to Wishlist
                        </button>
                        
                        <div class="flex items-center gap-3">
                            <span class="mr-1 hidden sm:inline font-medium">Share:</span>
                            <button class="text-gray-400 hover:text-gray-700 transition" title="Copy Link"><i class="bi bi-link-45deg text-xl"></i></button>
                            <button class="text-gray-400 hover:text-blue-600 transition" title="Facebook"><i class="bi bi-facebook text-lg"></i></button>
                            <button class="text-gray-400 hover:text-pink-500 transition" title="Instagram"><i class="bi bi-instagram text-lg"></i></button>
                            <button class="text-gray-400 hover:text-blue-400 transition" title="Twitter"><i class="bi bi-twitter text-lg"></i></button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-sm p-6 lg:p-8 mb-8">
            
            <!-- Tabs Menu -->
            <div class="mb-6 border-b border-gray-200">
                <ul class="flex flex-wrap -mb-px text-lg font-semibold text-center" id="productTab" role="tablist">
                    <li class="mr-6" role="presentation">
                        <button class="inline-block pb-4 border-b-2 rounded-t-lg transition-colors border-blue-600 text-blue-600" id="desc-tab" type="button" role="tab" onclick="switchTab('desc')">Description</button>
                    </li>
                    <li class="mr-6" role="presentation">
                        <button class="inline-block pb-4 border-b-2 rounded-t-lg transition-colors border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" id="specs-tab" type="button" role="tab" onclick="switchTab('specs')">Specifications</button>
                    </li>
                    <li class="mr-6" role="presentation">
                        <button class="inline-block pb-4 border-b-2 rounded-t-lg transition-colors border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" id="reviews-tab" type="button" role="tab" onclick="switchTab('reviews')">Reviews</button>
                    </li>
                </ul>
            </div>
            
            <div id="productTabContent">
                <!-- Description Tab -->
                <div class="block" id="desc" role="tabpanel">
                    <div class="prose max-w-none text-gray-700 text-sm leading-relaxed">
                        @Html.Raw(Model.Description)
                    </div>
                </div>

                <!-- Specifications Tab -->
                <div class="hidden" id="specs" role="tabpanel">
                    <div class="bg-white rounded-xl overflow-hidden border border-gray-200 shadow-sm max-w-4xl">
                        <table class="w-full text-sm text-left">
                            <tbody>
                                @if (Model.Attributes != null && Model.Attributes.Any())
                                {
                                    foreach (var attr in Model.Attributes)
                                    {
                                        <tr class="border-b border-gray-100 hover:bg-blue-50 transition">
                                            <td class="bg-slate-50 text-gray-700 p-4 font-semibold w-1/3 border-r border-gray-100">
                                                @attr.Key
                                            </td>
                                            <td class="p-4 text-gray-600 font-medium">
                                                @attr.Value
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="p-4 text-gray-500 text-center italic">No specifications available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Reviews Tab -->
                <div class="hidden" id="reviews" role="tabpanel">
                    <div class="space-y-6 max-w-4xl">
                        <!-- Khung bình luận 1 -->
                        <div class="border border-gray-100 p-4 rounded-xl bg-gray-50">
                            <div class="flex justify-between items-start mb-2">
                                <div class="flex gap-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold">
                                        A
                                    </div>
                                    <div>
                                        <h3 class="font-semibold text-gray-800">Nguyen Van A</h3>
                                        <p class="text-xs text-gray-500">20/08/2026</p>
                                    </div>
                                </div>
                                <div class="text-yellow-400 flex text-sm">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                                </div>
                            </div>
                            <p class="text-sm text-gray-600 mt-2">Sản phẩm rất tốt, đóng gói cẩn thận và giao hàng nhanh.</p>
                        </div>

                        <!-- Khung bình luận 2 -->
                        <div class="border border-gray-100 p-4 rounded-xl bg-gray-50">
                            <div class="flex justify-between items-start mb-2">
                                <div class="flex gap-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold">
                                        B
                                    </div>
                                    <div>
                                        <h3 class="font-semibold text-gray-800">Tran Thi B</h3>
                                        <p class="text-xs text-gray-500">15/08/2026</p>
                                    </div>
                                </div>
                                <div class="text-yellow-400 flex text-sm">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                                </div>
                            </div>
                            <p class="text-sm text-gray-600 mt-2">Chất lượng ổn trong tầm giá, sẽ giới thiệu cho bạn bè.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ======================= SẢN PHẨM LIÊN QUAN (CAROUSEL) ======================= -->
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <div class="bg-white rounded-xl shadow-sm p-6 lg:p-8 mb-8 relative">
                <h2 class="text-2xl font-bold mb-6 text-gray-900">Related Products</h2>
                
                <button id="btnPrevRelated" 
                        class="hidden absolute left-[10px] top-[55%] z-10 bg-white border border-gray-200 shadow-xl rounded-full w-12 h-12 flex items-center justify-center text-gray-600 hover:text-blue-600 hover:border-blue-600 transition-all">
                    <i class="bi bi-chevron-left text-xl"></i>
                </button>

                <div id="relatedCarousel" class="flex gap-4 overflow-x-hidden scroll-smooth snap-x snap-mandatory py-2">
                    @foreach (var p in Model.RelatedProducts)
                    {
                        <a class="group snap-start flex-none w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] lg:w-[calc(16.666%-0.83rem)] bg-white border border-gray-200 rounded-2xl p-4 h-[340px] flex flex-col overflow-hidden hover:shadow-2xl hover:border-blue-500 hover:-translate-y-2 transition-all duration-300"
                           href="@Url.Action("ProductDetail", "Catalog", new { id = p.ProductId })">
                            
                            <div class="h-[170px] flex items-center justify-center mb-3 overflow-hidden">
                                <img src="http://localhost:5678@(p.Thumbnail)" alt="@p.ProductName" class="max-h-full object-contain group-hover:scale-110 transition duration-500" />
                            </div>

                            <h3 class="text-sm font-semibold text-gray-800 leading-5 line-clamp-2 min-h-[40px] group-hover:text-blue-600 transition">
                                @p.ProductName
                            </h3>

                            <div class="flex items-center mt-2 text-xs text-yellow-400">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                            </div>

                            <div class="mt-auto pt-4 flex items-center justify-between">
                                <p class="font-bold text-sm text-red-600">
                                    @p.Price.ToString("N0") VND
                                </p>
                                <button type="button" 
                                        onclick="event.preventDefault(); event.stopPropagation(); addToCart(@p.ProductId, 1);"
                                        class="bg-blue-600 text-white w-full py-2 rounded font-semibold hover:bg-blue-700 transition">
                                    <i class="bi bi-cart-plus text-lg"></i>
                                </button>
                            </div>
                        </a>
                    }
                </div>

                <button id="btnNextRelated" 
                        class="absolute right-[10px] top-[55%] z-10 bg-white border border-gray-200 shadow-xl rounded-full w-12 h-12 flex items-center justify-center text-gray-600 hover:text-blue-600 hover:border-blue-600 transition-all">
                    <i class="bi bi-chevron-right text-xl"></i>
                </button>
            </div>
        }
        <section class="mt-5 mb-3 flex justify-center items-center mr-4 ml-4">
            <img src="~/images/banner/bottombanner2.png" alt="banner" class="w-full h-[420px] object-cover rounded-md" />
        </section> 

        <section class="bg-[#f5f5f7] py-16">

            <div class="max-w-7xl mx-auto">

                <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

                    <div class="flex flex-col items-center text-center">

                        <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center">
                            <img src="~/images/icons/Support.png" class="fa-solid fa-headset text-white text-lg" />
                        </div>

                        <h3 class="mt-6 text-lg font-semibold text-black">
                            Product Support
                        </h3>

                        <p class="mt-2 text-sm text-gray-500 max-w-[260px]">
                            Up to 3 years on-site warranty available for your peace of mind.
                        </p>

                    </div>

                    <!-- Item 2 -->
                    <div class="flex flex-col items-center text-center">

                        <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center">
                            <img src="~/images/icons/Account.png" class="fa-solid fa-headset text-white text-lg" />
                        </div>

                        <h3 class="mt-6 text-lg font-semibold text-black">
                            Personal Account
                        </h3>

                        <p class="mt-2 text-sm text-gray-500 max-w-[260px]">
                            With big discounts, free delivery and a dedicated support specialist.
                        </p>

                    </div>

                    <!-- Item 3 -->
                    <div class="flex flex-col items-center text-center">

                        <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center">
                            <img src="~/images/icons/Saving.png" class="fa-solid fa-headset text-white text-lg" />
                        </div>

                        <h3 class="mt-6 text-lg font-semibold text-black">
                            Amazing Savings
                        </h3>

                        <p class="mt-2 text-sm text-gray-500 max-w-[260px]">
                            Up to 70% off new products, you can be sure of the best price.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tabId) {
            // hide all tabs
            document.getElementById('desc').classList.add('hidden');
            document.getElementById('desc').classList.remove('block');
            document.getElementById('specs').classList.add('hidden');
            document.getElementById('specs').classList.remove('block');
            document.getElementById('reviews').classList.add('hidden');
            document.getElementById('reviews').classList.remove('block');

            // reset buttons
            const btnIds = ['desc-tab', 'specs-tab', 'reviews-tab'];
            btnIds.forEach(id => {
                const btn = document.getElementById(id);
                btn.classList.remove('border-blue-600', 'text-blue-600');
                btn.classList.add('border-transparent', 'text-gray-500');
            });

            // show selected tab
            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById(tabId).classList.add('block');

            // active selected button
            const activeBtn = document.getElementById(tabId + '-tab');
            activeBtn.classList.remove('border-transparent', 'text-gray-500');
            activeBtn.classList.add('border-blue-600', 'text-blue-600');
        }

        document.addEventListener("DOMContentLoaded", function () {
            const carousel = document.getElementById('relatedCarousel');
            const btnPrev = document.getElementById('btnPrevRelated');
            const btnNext = document.getElementById('btnNextRelated');

            if (!carousel) return;

            const updateButtons = () => {
                if (carousel.scrollLeft <= 0) {
                    btnPrev.classList.add('hidden');
                } else {
                    btnPrev.classList.remove('hidden');
                }

                if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 1) {
                    btnNext.classList.add('hidden');
                } else {
                    btnNext.classList.remove('hidden');
                }
            };

            const scrollCarousel = (direction) => {
                const firstCard = carousel.querySelector('a');
                if (!firstCard) return;

                const scrollAmount = firstCard.clientWidth + 16; 
                carousel.scrollBy({
                    left: direction === 'next' ? scrollAmount : -scrollAmount,
                    behavior: 'smooth'
                });
            };

            btnNext.addEventListener('click', () => scrollCarousel('next'));
            btnPrev.addEventListener('click', () => scrollCarousel('prev'));

            carousel.addEventListener('scroll', updateButtons);
            setTimeout(updateButtons, 100);
            window.addEventListener('resize', updateButtons);
        });
        document.addEventListener("DOMContentLoaded", function () {
            const inputQty = document.getElementById('detail-qty-input');

            document.getElementById('btn-detail-minus').addEventListener('click', () => {
                let val = parseInt(inputQty.value);
                if (val > 1) inputQty.value = val - 1;
            });
            document.getElementById('btn-detail-plus').addEventListener('click', () => {
                inputQty.value = parseInt(inputQty.value) + 1;
            });

            document.getElementById('btn-detail-add-cart').addEventListener('click', () => {
                let quantity = parseInt(inputQty.value);
                addToCart(@Model.ProductId, quantity);
            });
        });
    </script>
}
