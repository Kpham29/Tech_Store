@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "_AdminLayout";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600">
            <i class="bi bi-person-badge-fill text-xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-gray-800">Welcome to Staff Dashboard</h2>
    </div>
    
    <p class="text-gray-600 leading-relaxed mb-6">
        Here you can manage products, monitor active orders, and respond to customer requests.
        As <strong class="text-gray-800">Staff</strong>, your main priority is ensuring smooth daily operations and customer satisfaction.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50 flex flex-col gap-2">
            <span class="text-gray-500 text-sm font-medium uppercase tracking-wide">Orders to Process</span>
            <span class="text-3xl font-bold text-orange-600">12</span>
        </div>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50 flex flex-col gap-2">
            <span class="text-gray-500 text-sm font-medium uppercase tracking-wide">Low Stock Products</span>
            <span class="text-3xl font-bold text-red-600">8</span>
        </div>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50 flex flex-col gap-2">
            <span class="text-gray-500 text-sm font-medium uppercase tracking-wide">New Requests</span>
            <span class="text-3xl font-bold text-blue-600">5</span>
        </div>
    </div>
</div>
