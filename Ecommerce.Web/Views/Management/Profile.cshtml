@model Ecommerce.Web.Models.CustomerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_AdminLayout";
    var avatarUrl = string.IsNullOrEmpty(Model?.Avatar) ? "/images/default-avatar.png" : "http://localhost:5678" + Model.Avatar;
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-8">
    <div class="border-b border-gray-200 pb-4 mb-6">
        <h1 class="text-xl font-bold text-gray-800">My Profile</h1>
        <p class="text-sm text-gray-500 mt-1">Manage your staff/admin account information.</p>
    </div>

    @if (ViewBag.Success != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md text-sm">
            @ViewBag.Success
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md text-sm">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Profile" method="post" enctype="multipart/form-data" class="flex flex-col-reverse md:flex-row gap-8">
        <!-- Left side: Form fields -->
        <div class="flex-1 pr-0 md:pr-12">
            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Username</label>
                <div class="w-2/3 text-gray-800 font-medium bg-gray-50 px-3 py-2 rounded border border-gray-100 cursor-not-allowed">
                    @Model?.Username
                </div>
                <input type="hidden" asp-for="Username" />
            </div>
            
            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Full name</label>
                <div class="w-2/3">
                    <input type="text" asp-for="FullName" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-500 transition">
                </div>
            </div>

            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Email</label>
                <div class="w-2/3">
                    <input type="email" asp-for="Email" readonly class="w-full px-3 py-2 border border-gray-200 bg-gray-100 text-gray-500 rounded text-sm cursor-not-allowed focus:outline-none">
                </div>
            </div>

            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Phone number</label>
                <div class="w-2/3">
                    <input type="text" asp-for="Phone" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-500 transition">
                </div>
            </div>

            <div class="mb-5 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Address</label>
                <div class="w-2/3">
                    <input type="text" asp-for="Address" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-500 transition">
                </div>
            </div>

            <div class="mb-8 flex items-center">
                <label class="w-1/3 text-right pr-6 text-sm text-gray-500 font-medium">Created At</label>
                <div class="w-2/3 text-gray-800 text-sm">
                    @(Model?.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")
                </div>
            </div>

            <div class="flex items-center">
                <div class="w-1/3"></div>
                <div class="w-2/3">
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-medium rounded shadow hover:bg-blue-700 transition">Save Changes</button>
                </div>
            </div>
        </div>

        <!-- Right side: Avatar upload -->
        <div class="w-full md:w-1/3 flex flex-col items-center border-t md:border-t-0 md:border-l border-gray-200 pt-6 md:pt-0">
            <img id="avatarPreview" src="@avatarUrl" class="w-32 h-32 rounded-full object-cover mb-4 border border-gray-200 bg-gray-50 shadow-sm">
            <label for="avatarFile" class="cursor-pointer border border-gray-300 px-4 py-2 text-sm text-gray-700 bg-white hover:bg-gray-50 transition shadow-sm rounded font-medium">
                Select Image
            </label>
            <input type="file" id="avatarFile" name="avatarFile" class="hidden" accept=".jpg,.jpeg,.png" onchange="previewImage(event)">
            <div class="text-xs text-gray-500 text-center mt-4 space-y-1">
                <p>File size: maximum 1 MB</p>
                <p>File extension: .JPEG, .PNG</p>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                // Validate file size (1MB max)
                if (file.size > 1024 * 1024) {
                    alert("File size exceeds 1 MB. Please choose a smaller file.");
                    event.target.value = ''; // Reset input
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}
