@{
    var role = ViewBag.Role as string ?? "";
}

<aside class="w-64 bg-white shadow-sm flex-shrink-0 h-full flex flex-col border-r border-gray-200 z-20 relative">
    <!-- Logo -->
    <div class="h-16 flex items-center px-6 border-b border-gray-200">
        <a href="@(role == "Admin" ? "/Admin/Dashboard" : "/Staff/Dashboard")" class="flex items-center gap-2">
            <div class="w-8 h-8 bg-[#ececec] rounded flex items-center justify-center">
                <img src="~/images/logo/Logo.png" class="w-full h-full object-cover" />
            </div>
            <span class="font-bold text-gray-800 text-lg">Management</span>
        </a>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto py-4">
        <ul class="space-y-1">
            <!-- Common items for Staff and Admin -->
            <li>
                <a href="@(role == "Admin" ? "/Admin/Dashboard" : "/Staff/Dashboard")" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="bi bi-speedometer2 text-lg"></i>
                    <span class="font-medium text-sm">Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Products" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="bi bi-box-seam text-lg"></i>
                    <span class="font-medium text-sm">Products</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Orders" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="bi bi-cart-check text-lg"></i>
                    <span class="font-medium text-sm">Orders</span>
                </a>
            </li>
            <li>
                <a href="/Admin/CustomerRequests" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="bi bi-headset text-lg"></i>
                    <span class="font-medium text-sm">Customer Requests</span>
                </a>
            </li>

            @if (role == "Admin")
            {
                <li class="pt-4 pb-2 px-6">
                    <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Admin Only</div>
                </li>
                <li>
                    <a href="/Admin/Users" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                        <i class="bi bi-people text-lg"></i>
                        <span class="font-medium text-sm">Users</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Catalog" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                        <i class="bi bi-tags text-lg"></i>
                        <span class="font-medium text-sm">Categories & Brands</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Reports" class="flex items-center gap-3 px-6 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                        <i class="bi bi-bar-chart text-lg"></i>
                        <span class="font-medium text-sm">Reports</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
</aside>
