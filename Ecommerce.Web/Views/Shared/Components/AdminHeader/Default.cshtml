@{
    var username = ViewBag.Username as string;
    var role = ViewBag.Role as string;
    var avatar = ViewBag.Avatar as string;
}

<header class="h-16 bg-white shadow-sm border-b border-gray-200 flex items-center justify-between px-6 z-10 flex-shrink-0">
    <div class="flex items-center gap-4">
        <!-- Optional Toggle Button for Mobile Sidebar -->
        <button class="text-gray-500 hover:text-gray-800 lg:hidden focus:outline-none">
            <i class="bi bi-list text-2xl"></i>
        </button>
        <h1 class="text-lg font-semibold text-gray-800 hidden md:block">
            @(ViewData["Title"] ?? "Dashboard")
        </h1>
    </div>

    <div class="flex items-center gap-5">
        <button class="text-gray-500 hover:text-gray-800 text-lg relative focus:outline-none">
            <i class="bi bi-bell"></i>
            <!-- Notification Badge (Example) -->
            <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[9px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-bold">2</span>
        </button>

        <div class="w-px h-8 bg-gray-200"></div>

        <!-- User Dropdown -->
        <div class="relative group">
            <button class="flex items-center gap-2 focus:outline-none">
                <div class="w-9 h-9 rounded-full overflow-hidden border-[1.5px] border-blue-600 flex items-center justify-center text-blue-600 bg-blue-50">
                    @if (!string.IsNullOrEmpty(avatar))
                    {
                        <img src="http://localhost:5678@(avatar)" class="w-full h-full object-cover" alt="User Avatar" />
                    }
                    else
                    {
                        <i class="bi bi-person-fill text-lg"></i>
                    }
                </div>
                <div class="hidden md:flex flex-col text-left">
                    <span class="text-sm font-semibold text-gray-800 leading-tight">@(username ?? "User")</span>
                    <span class="text-xs text-gray-500 font-medium">@(role ?? "Staff")</span>
                </div>
                <i class="bi bi-chevron-down text-gray-400 text-xs ml-1"></i>
            </button>

            <!-- Dropdown Menu -->
            <div class="absolute right-0 top-full mt-2 w-48 bg-white border border-gray-200 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
                <a href="/Management/Profile" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-600 transition-colors">
                    <i class="bi bi-person mr-2"></i> My Profile
                </a>
                <div class="border-t border-gray-100"></div>
                <a href="/Auth/Logout" class="block px-4 py-2.5 text-sm text-red-500 hover:bg-red-50 rounded-b-lg transition-colors">
                    <i class="bi bi-box-arrow-right mr-2"></i> Logout
                </a>
            </div>
        </div>
    </div>
</header>
